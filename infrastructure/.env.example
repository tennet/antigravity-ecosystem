# ==============================================================================
# .env.example - Master Environment Specification
# DevOps & Infrastructure Sage (v3.0.0)
# ==============================================================================

# Application Environment
APP_NAME="SecureLaravelMicroservice"
APP_ENV=production
APP_KEY=base64:GENERATE_ME_USING_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=http://localhost:8080

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8.4 LTS Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel_production
DB_USERNAME=app_user
DB_PASSWORD=ChangeThisSecurePassword_MySQL84!
MYSQL_ROOT_PASSWORD=RootSuperSecurePassword_DoNotLeak!

# Cache & Session Driver
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Cache Service
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Exposed Host Ports
HOST_HTTP_PORT=8080
HOST_DB_PORT=3306
